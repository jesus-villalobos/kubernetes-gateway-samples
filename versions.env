# Pinned versions and shared settings for the Kubernetes Gateway API samples.
# Everything here points at public, freely available projects and images.
# Adjust to the latest stable patch as needed.

# Gateway API CRDs (standard channel), installed once for all implementations.
GATEWAY_API_VERSION="v1.2.1"

# Istio (ambient profile is used so the gRPC/mesh sample works).
ISTIO_VERSION="1.24.3"

# Envoy Gateway (installed from its published GitHub release manifest).
ENVOY_GATEWAY_VERSION="v1.2.6"

# Higress (installed from its public Helm repository).
HIGRESS_CHART_VERSION="2.2.4"

# Public demo images.
ECHO_IMAGE="ealen/echo-server:0.9.2"   # HTTP echo: reflects method/path/headers/host as JSON
FORTIO_IMAGE="fortio/fortio:latest"    # gRPC server + load client for the mesh sample
REDIS_IMAGE="redis:7-alpine"           # backs Envoy Gateway global rate limiting

# One cluster, separated by namespace + GatewayClass.
NS_ISTIO="istio-demo"
NS_ENVOY="envoy-demo"
NS_HIGRESS="higress-demo"
NS_GRPC="grpc-demo"

# Local ports used by kubectl port-forward while running the samples.
LOCAL_ISTIO_K8S=18080     # K8s Gateway (class istio) auto-provisioned service
LOCAL_ISTIO_CLASSIC=18081 # istio ingress gateway (Istio API + regex rewrite)
LOCAL_ENVOY=18082         # Envoy Gateway service
LOCAL_HIGRESS=18083       # Higress gateway service

# Hostname used by the samples (sent via the Host header; no DNS or /etc/hosts).
DEMO_HOST="api.example.com"
